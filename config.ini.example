# Copy to config.ini (git-ignored) next to main.py, or point SMARTSENSOR_CONFIG at it.
# Any key can also be set as an env var: SMARTSENSOR_SENSOR_NAME, SMARTSENSOR_BROKER_HOST, ...
# Env vars take precedence over this file.
#
# The four HA identity keys (device_id, device_name, temp_unique_id, hum_unique_id) default to the
# bedroom values below. A Pi that omits them publishes AS the bedroom's HA entities, so every other
# Pi MUST set all four.
[sensor]
sensor_name = sensorAttic
client_id = PiSensorClient
broker_host = 192.168.1.252
broker_port = 1883
log_path = /home/k4nuck/projects/dht22/dh22.log
device_id = Attic01ae
device_name = Attic
temp_unique_id = temp01ae
hum_unique_id = hum01ae
# fifo_path is optional; defaults to temp.fifo in the log_path directory.

# Values in use on 2026-10-08:
#
# Bedroom Pi (k4nuck-pi)
#   sensor_name    = sensorAttic
#   client_id      = PiSensorClient
#   broker_host    = 192.168.1.252
#   log_path       = /home/k4nuck/projects/dht22/dh22.log
#   device_id      = Attic01ae
#   device_name    = Attic
#   temp_unique_id = temp01ae
#   hum_unique_id  = hum01ae
#
# Crawlspace Pi (100.123.50.43)
#   sensor_name    = sensorCrawlspace
#   client_id      = PiSensorClientCrawlspace
#   broker_host    = ha-main-remote.tail9144d.ts.net
#   log_path       = /home/k4nuck/projects/dht22/dht22.log
#   device_id      = Crawlspace01
#   device_name    = Crawlspace
#   temp_unique_id = tempCrawl01
#   hum_unique_id  = humCrawl01

# Check-in mode (no Tailscale): report to gergy-edge over HTTPS and bridge a local zigbee2mqtt thermostat.
# Set transport = checkin in [sensor]; broker_host and client_id are then not needed. Omitting transport keeps
# the MQTT behaviour above. In this mode device_id is REQUIRED and is the gateway's device id (not the HA
# discovery identity), and broker_port is the port of the Pi's local mosquitto.
# zigbee2mqtt must have availability enabled (1.x 'availability: true', 2.x 'availability: enabled: true'; off by default;
# Gergy enables it on the Pi) and advanced.last_seen. Without availability the thermostat always reports available:false
# and no desired change is ever written.
# Prefer the token as an env var (SMARTSENSOR_CHECKIN_TOKEN, e.g. in the unit's EnvironmentFile) over this file.
#
# [sensor]
# sensor_name = sensorCrawlspace
# log_path = /home/k4nuck/projects/dht22/dht22.log
# transport = checkin
# checkin_url = https://gergy-edge.hopto.org/devices/checkin
# checkin_token = <device token>
# device_id = crawlspace
# local_mqtt_host = 127.0.0.1
# thermostat_name = crawlspace_thermostat
# thermostat_unit = c
# setpoint_floor_f = 45
# setpoint_ceiling_f = 65
# thermostat_allowed_modes = heat
#
# Contract v1.1: thermostat_name may list several thermostats, comma-separated; each is reported and controlled
# under its own name. The four thermostat_* / setpoint_* keys above are the defaults for all of them, and a
# [thermostat:<name>] section overrides them for one. The Pi enforces these bounds and allowed modes itself, so a
# desired change outside them is answered rejected_bounds and never written. The allowed-modes default is
# heat only (any of heat, off, cool, auto), so a desired system_mode of off is rejected unless a thermostat opts in.
#
# [thermostat:crawlspace_thermostat]
# setpoint_floor_f = 45
# setpoint_ceiling_f = 65
# thermostat_allowed_modes = heat
